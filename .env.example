# OpenRouter (recomendado): https://openrouter.ai/keys
# Crie uma chave, deposite saldo e copie aqui.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Modelo global (usado quando o agente não tem override próprio).
# Mantenha vazio para usar os defaults por agente (mais econômico).
# OPENROUTER_MODEL=anthropic/claude-opus-4.7

# ----------------------------------------------------------------------------
# Modelos por agente (override fino — recomendado para reduzir custo)
# ----------------------------------------------------------------------------
# Defaults atuais no código (não precisa setar nada se quiser usar esses):
#   Triager           → anthropic/claude-haiku-4.5
#   EmpresaAgent      → anthropic/claude-haiku-4.5
#   CentroDeCustoAgent → anthropic/claude-sonnet-4.5
#   PlanoDeContasAgent → anthropic/claude-opus-4.7
#   RazaoContabilAgent → anthropic/claude-sonnet-4.5
# ----------------------------------------------------------------------------
# MODEL_TRIAGER=anthropic/claude-haiku-4.5
# MODEL_ESTRUTURA_EMPRESARIAL=anthropic/claude-haiku-4.5
# MODEL_CENTRO_DE_CUSTO=anthropic/claude-sonnet-4.5
# MODEL_PLANO_DE_CONTAS=anthropic/claude-opus-4.7
# MODEL_RAZAO_CONTABIL=anthropic/claude-sonnet-4.5

# Limite de output em tokens. Opus suporta até 32k.
CLAUDE_MAX_TOKENS=32000

# Tamanhos de chunk (chunks GRANDES por padrão, raramente fragmenta).
# Para tabular, a contagem é APÓS pre_filter (sintéticas já filtradas).
# Aumente para arquivos com plano de contas muito grande (setor público, etc.).
CHUNK_PDF_PAGES=30
CHUNK_TABULAR_ROWS=1500
CHUNK_TEXT_CHARS=100000

# Espera entre chunks. 0 = sem espera (recomendado para OpenRouter).
CLAUDE_RATE_LIMIT_WAIT_SECONDS=0

# Timeout por chamada LLM (segundos). Opus pode demorar com PDF grande.
CLAUDE_TIMEOUT_SECONDS=300

# Self-review pode rodar até este número de registros (acima disso, é skipado).
CLAUDE_SELF_REVIEW_MAX_RECORDS=200

# Senha opcional do app
APP_PASSWORD=
MAX_UPLOAD_MB=30
